{
  "name": "@deepseek-ai/dsh-desktop",
  "description": "Electron desktop application for DeepSeek Harness with an in-process IPC transport",
  "author": "OpenSeek Contributors",
  "version": "0.1.7",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "apps/desktop"
  },
  "type": "module",
  "main": "lib/bootstrap.cjs",
  "exports": {
    "./package.json": "./package.json"
  },
  "files": [
    "assets/icon.png",
    "lib/*.js",
    "lib/*.cjs",
    "config"
  ],
  "scripts": {
    "start": "electron ."
  },
  "license": "MIT",
  "dependencies": {
    "@deepseek-ai/dsh": "workspace:^",
    "@deepseek-ai/dsh-app-boot": "workspace:^",
